# ==============================================================================
# DevArena — Git Ignore Rules (.gitignore)
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment Variables & Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.crt
*.pfx
*.p12

# Backend (Java / Spring Boot / Maven)
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
*.nar
*.log
*.h2.db
*.trace.db

# Frontend (Node.js / Vite / React / TypeScript)
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.eslintcache
frontend/.stylelintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDEs & Code Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*~

# Database, Redis & Container Volumes
docker/data/
/data/
*.rdb
*.aof
postgres_data/
redis_data/

# Antigravity / AI Agent Scratch Directory
scratch/
.system_generated/
