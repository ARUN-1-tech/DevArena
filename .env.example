# ==============================================================================
# DevArena Environment Configuration Template
# Copy this file to .env before starting containers or local services.
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=development
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
POSTGRES_DB=devarena
POSTGRES_USER=devarena_user
POSTGRES_PASSWORD=devarena_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# REDIS CACHE & MESSAGING
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# SECURITY & JWT (Prepared for Module 03)
# ------------------------------------------------------------------------------
# Base64-encoded secret key (minimum 256-bit for HS256 / HS512)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# FRONTEND SETTINGS (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws

# ------------------------------------------------------------------------------
# FUTURE MODULE PLACEHOLDERS (Module 05+ Code Execution & AI)
