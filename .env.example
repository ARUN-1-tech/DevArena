# ==============================================================================
# DevArena Platform — Environment Configuration Template (.env.example)
# Copy this file to .env before starting containers or local development:
#   cp .env.example .env
# NEVER commit the actual .env file with production credentials into version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION & PORTS
# ------------------------------------------------------------------------------
APP_ENV=development
SERVER_PORT=8080
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
POSTGRES_DB=devarena
POSTGRES_USER=devarena_user
POSTGRES_PASSWORD=devarena_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# REDIS IN-MEMORY CACHE & STOMP BROKER
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SPRING_DATA_REDIS_HOST=${REDIS_HOST}
SPRING_DATA_REDIS_PORT=${REDIS_PORT}

# ------------------------------------------------------------------------------
# SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Base64-encoded secret key (minimum 256-bit for HS256 / HS512)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000          # 24 Hours
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 Days

# ------------------------------------------------------------------------------
# CODE EXECUTION SANDBOX
# ------------------------------------------------------------------------------
EXECUTION_TIMEOUT_MS=5000
EXECUTION_SANDBOX_ENABLED=true

# ------------------------------------------------------------------------------
# FRONTEND VITE CLIENT
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws
