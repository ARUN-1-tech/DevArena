# ==============================================================================
# DevArena Platform — Environment Configuration Template (.env.example)
#
# QUICK START:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your environment variables below
# 3. Start containers: docker-compose up -d --build
#
# SECURITY WARNING: NEVER commit your actual .env file to public version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & PORTS CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=production
SERVER_PORT=8080
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80,https://yourdomain.com

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_DB=devarena
POSTGRES_USER=devarena_user
POSTGRES_PASSWORD=devarena_secret_change_me_in_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. REDIS IN-MEMORY CACHE & STOMP BROKER
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
SPRING_DATA_REDIS_HOST=${REDIS_HOST}
SPRING_DATA_REDIS_PORT=${REDIS_PORT}

# ------------------------------------------------------------------------------
# 4. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a secure 512-bit Base64 or Hex key for production:
# openssl rand -base64 64
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000          # 24 Hours
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 Days

# ------------------------------------------------------------------------------
# 5. CODE EXECUTION SANDBOX
# ------------------------------------------------------------------------------
EXECUTION_TIMEOUT_MS=5000
EXECUTION_SANDBOX_ENABLED=true
EXECUTION_MEMORY_LIMIT_MB=256

# ------------------------------------------------------------------------------
# 6. FRONTEND VITE CLIENT BINDINGS
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws

# ------------------------------------------------------------------------------
# 7. OPTIONAL AI COACH (Gemini / Claude / OpenAI API)
# ------------------------------------------------------------------------------
AI_COACH_ENABLED=true
GEMINI_API_KEY=
OPENAI_API_KEY=
