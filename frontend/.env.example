# Backend API Base URL
# For production on Vercel connecting to Render:
# VITE_API_BASE_URL=https://devarenadevarena-backend.onrender.com
#
# For local development (leave empty to use Vite dev proxy to http://localhost:8080):
VITE_API_BASE_URL=
